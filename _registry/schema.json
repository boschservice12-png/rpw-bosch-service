{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RPW funkcióregiszter bejegyzés (v2)",
  "type": "object",
  "required": ["id","nev","fe","be","teszt","allapot","category","criticality",
               "owner","chain","nextFunctions","lifecycle","backendType",
               "productionStatus","verification"],
  "properties": {
    "id":          {"type":"string","pattern":"^F-\\d{3}$","description":"Állandó szám. SOHA nem változik, nem használjuk újra."},
    "nev":         {"type":"string","minLength":6},
    "fe":          {"type":"array","items":{"type":"array","prefixItems":[{"type":"string"},{"type":"string"}]},
                    "description":"Frontend-horgonyok: [fájl, keresett szöveg] — létezniük KELL."},
    "be":          {"type":"array","items":{"type":"string"},
                    "description":"Backend nevek a _migrations-ből (POSTGRES_RPC) vagy functions/-ból."},
    "teszt":       {"type":["string","null"],"description":"Az őrző tesztfájl. null = NINCS TESZTJE."},
    "allapot":     {"enum":["el","csak-frontend","csak-backend","nincs-bekotve"],
                    "description":"A BEKÖTÖTTSÉG ténye (örökölt v1 mező)."},
    "category":    {"enum":["BUSINESS_CAPABILITY","SECURITY_CONTROL","WORKFLOW_TRANSITION",
                            "UI_COMPONENT","DATA_OPERATION","INTEGRATION","INFRASTRUCTURE","ADMIN_OPERATION"]},
    "criticality": {"enum":["P0","P1","P2","P3"],"description":"Súly: P0=10, P1=5, P2=2, P3=1."},
    "owner":       {"enum":["Reception","Production","Quality","Office","Platform"]},
    "chain":       {"type":"string","pattern":"^([1-9]|10)$","description":"Értéklánc-szakasz (1 Belépés … 10 Infrastruktúra)."},
    "nextFunctions":{"type":"array","items":{"type":"string","pattern":"^F-\\d{3}$"}},
    "lifecycle":   {"enum":["ACTIVE","DEPRECATED","REMOVED"],"description":"KÉZI életciklus-döntés."},
    "backendType": {"enum":["POSTGRES_RPC","SERVERLESS_FUNCTION","STORAGE","EXTERNAL_API","NONE"]},
    "auditRequired":{"type":"boolean"},
    "blockers":    {"type":"array","items":{"type":"string"}},
    "productionStatus": {"enum":["PLANNED","IMPLEMENTED","UNIT_VERIFIED","INTEGRATION_VERIFIED",
                                 "UI_VERIFIED","STAGING_VERIFIED","PRODUCTION_VERIFIED",
                                 "DORMANT","BLOCKED","DEPRECATED","REMOVED"],
                    "description":"GÉP SZÁMOLJA (derive.js) a teszteredményből + horgonyokból + evidence.json-ból. Kézzel átírni TILOS."},
    "verification": {"type":"object","required":["unit","database","ui","e2e","staging","production"],
      "properties":{"unit":{"type":"boolean"},"database":{"type":"boolean"},"ui":{"type":"boolean"},
        "e2e":{"type":"boolean"},"staging":{"type":"boolean"},"production":{"type":"boolean"}},
      "description":"staging/production/e2e CSAK az evidence.json emberi bizonyítékából lehet true."},
    "anchorsOk":   {"type":"boolean"},
    "lastVerifiedAt":{"type":["string","null"]}
  }
}
