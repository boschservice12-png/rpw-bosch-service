[Unit]
Description=RPW — az új fotók másolata a MÁSIK szolgáltatóhoz (a célban soha nem töröl)
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=rpw
WorkingDirectory=__RPW_HOME__/current/symfony
ExecStart=/usr/bin/php bin/console rpw:storage:replicate --report=__RPW_HOME__/shared/log/replica.json --no-interaction
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=__RPW_HOME__/shared/log
ReadOnlyPaths=__RPW_HOME__
PrivateTmp=true
