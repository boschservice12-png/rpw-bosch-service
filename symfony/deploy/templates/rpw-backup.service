[Unit]
Description=RPW titkosított mentés (adatbázis + fotók), visszaellenőrzéssel
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=rpw
WorkingDirectory=__RPW_HOME__/current/symfony
ExecStart=/usr/bin/php bin/console rpw:backup --to=__RPW_BACKUPS__ --keep=14 --no-interaction
# a mentés másolata a gépen KÍVÜLRE is kell (3-2-1 szabály) — lásd TELEPITES.md 6. lépés
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=__RPW_BACKUPS__ __RPW_HOME__/shared/log
ReadOnlyPaths=__RPW_HOME__
PrivateTmp=true
